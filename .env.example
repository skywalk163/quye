# quye.com 本地开发环境变量
# 复制此文件为 .env 后填入真实值（.env 已 gitignore）

# ─── GitHub CLI (gh) ───
# 用于：本地触发 upstream-drift workflow、查看 CI 状态、管理 issue
# 获取方式：https://github.com/settings/tokens → Generate new token (classic)
# 权限：repo, workflow
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── 本地语言仓库路径（可选，加速构建，CI 里不需要） ───
# 留空或删掉整行 → 建站.py 自动走远端 clone
# 填绝对路径 → 跳过 clone 直接用本地仓库（开发迭代快）
QUYE_LOCAL_极快=G:\traework\jikuai
QUYE_LOCAL_段言=C:\dumatework\duan
QUYE_LOCAL_光明=
QUYE_LOCAL_知行=g:\zhixing
